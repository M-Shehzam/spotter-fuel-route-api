    {
      "name": "4 \u00b7 The price data",
      "item": [
        {
          "name": "Cheapest in Texas",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/stations/?state=TX&ordering=retail_price&limit=10",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "stations"
              ],
              "query": [
                {
                  "key": "state",
                  "value": "TX"
                },
                {
                  "key": "ordering",
                  "value": "retail_price"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            },
            "description": ""
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const b = pm.response.json();",
                  "pm.test('all Texan', () => b.results.forEach(r => pm.expect(r.state).to.eql('TX')));",
                  "pm.test('cheapest first', () => {",
                  "  const p = b.results.map(r => parseFloat(r.retail_price));",
                  "  pm.expect(p).to.eql(p.slice().sort((a,b) => a-b));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Search by brand",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/stations/?search=PILOT&limit=10",
              "host": [
