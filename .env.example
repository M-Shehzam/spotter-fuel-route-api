# Copy to .env and adjust. Every value below has a working default, so an
# empty .env still yields a runnable service (SQLite + in-process cache).

DEBUG=True
SECRET_KEY=dev-insecure-key-do-not-use-in-production
ALLOWED_HOSTS=*
LOG_LEVEL=INFO

# Unset -> SQLite at ./db.sqlite3
# DATABASE_URL=postgres://fuelroute:fuelroute@localhost:5432/fuelroute

# Unset -> in-process LocMemCache
# REDIS_URL=redis://localhost:6379/0

ROUTE_CACHE_TTL_SECONDS=86400

# Vehicle envelope from the assessment brief
VEHICLE_MAX_RANGE_MILES=500
VEHICLE_MPG=10

# Corridor and origin search radii
MAX_DETOUR_MILES=10
ORIGIN_FUEL_RADIUS_MILES=30

# Routing provider. The OSRM demo server requires no API key.
ROUTING_PROVIDER=osrm
OSRM_BASE_URL=https://router.project-osrm.org
ROUTING_TIMEOUT_SECONDS=15
